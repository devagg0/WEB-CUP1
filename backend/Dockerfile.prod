FROM php:8.2-apache

# 1. Instalar dependencias del sistema y extensiones de PHP para PostgreSQL
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libpq-dev \
    && docker-php-ext-install pdo pdo_pgsql

# 2. Habilitar el módulo rewrite de Apache (necesario para Laravel)
RUN a2enmod rewrite

# 3. Configurar Apache para servir desde la carpeta /public de Laravel
ENV APACHE_DOCUMENT_ROOT /var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/apache2.conf

# 4. Copiar el ejecutable de Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# 5. Configurar el directorio de trabajo limpio
WORKDIR /var/www/html

# 6. Copiar el código del backend
COPY backend/ .

# 7. Configurar permisos e instalar dependencias de Composer sin desarrollo
ENV COMPOSER_ALLOW_SUPERUSER=1
RUN composer install --no-dev --optimize-autoloader

# 8. Asegurar permisos correctos para el storage y caché de bootstrap (ejecutado como www-data)
RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

# 9. Exponer el puerto de Apache (por defecto 80)
EXPOSE 80

# 10. Arrancar enlazando storage y corriendo migraciones antes de levantar Apache
CMD sh -c "php artisan storage:link --force && php artisan migrate --force && apache2-foreground"
